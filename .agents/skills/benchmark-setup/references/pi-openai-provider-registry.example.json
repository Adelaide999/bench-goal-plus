{
  "providers": {
    "deepseek-responses": {
      "baseUrl": "https://api.deepseek.com/v1",
      "api": "openai-responses",
      "apiKey": "$DEEPSEEK_API_KEY",
      "authHeader": true,
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": true,
        "supportsStore": false
      },
      "models": [
        {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash via OpenAI Responses",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1000000,
          "maxTokens": 384000
        }
      ]
    },
    "zai-openai": {
      "baseUrl": "https://api.z.ai/api/coding/paas/v4",
      "api": "openai-completions",
      "apiKey": "$ZAI_API_KEY",
      "authHeader": true,
      "models": [
        {
          "id": "glm-5.2",
          "name": "GLM-5.2 via Z.AI OpenAI Chat Completions",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 200000,
          "maxTokens": 131072
        }
      ]
    }
  }
}
